# IkedaDev Platform - Events API Environment Configuration

# Server
PORT=8080
HOST=0.0.0.0
ENVIRONMENT=development
RUST_LOG=info,events_api=debug,ikeda_core=debug,tower_http=debug

# PostgreSQL / Neon Database (supports poolers like PgBouncer)
# For Neon: postgres://user:password@ep-xyz.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/events_db?sslmode=disable
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=5

# Upstash QStash (Phase 5)
QSTASH_URL=https://qstash.upstash.io/v2
QSTASH_TOKEN=your-qstash-token-here
QSTASH_CURRENT_SIGNING_KEY=your-signing-key
QSTASH_NEXT_SIGNING_KEY=your-next-signing-key
